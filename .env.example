# Neuclip Studio — copy to .env (never commit real keys).
# Secrets are normally entered in the in-app settings screen and stored in the OS
# keychain; .env is the local-config fallback for development.

# WaveSpeed image-to-image API key.
WAVESPEED_API_KEY=

# Anthropic API key (prompt-profile research + synthesis, Phase 8).
ANTHROPIC_API_KEY=

# Optional: pin the sidecar port (otherwise fixed-with-fallback from 8756).
# NEUCLIP_SIDECAR_PORT=8756
