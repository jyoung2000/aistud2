{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "dialog:allow-save",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": ["$HOME/**", "$DOWNLOAD/**", "$DOCUMENT/**", "$DESKTOP/**", "$PICTURE/**"]
    }
  ]
}
