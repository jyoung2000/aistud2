{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Neuclip .nprofile",
  "type": "object",
  "required": ["model", "paradigm"],
  "additionalProperties": true,
  "properties": {
    "model": { "type": "string", "maxLength": 200 },
    "paradigm": { "type": "string", "maxLength": 64 },
    "version": { "type": "string", "maxLength": 64 },
    "layer": { "enum": ["base", "user", "research"] },
    "prompt_grammar": {
      "type": "object",
      "properties": {
        "voice": { "enum": ["imperative", "declarative-description", "caption-style"] },
        "person": { "type": "string", "maxLength": 64 },
        "tense": { "type": "string", "maxLength": 32 },
        "ideal_length_tokens": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "structure": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "maxItems": 12 }
      }
    },
    "dos": { "$ref": "#/definitions/claimList" },
    "donts": { "$ref": "#/definitions/claimList" },
    "negative_prompt": {
      "type": "object",
      "properties": {
        "supported": { "type": "boolean" },
        "field": { "type": ["string", "null"], "maxLength": 64 },
        "default": { "type": ["string", "null"], "maxLength": 1000 },
        "source": { "type": "string", "maxLength": 500 },
        "confidence": { "enum": ["confirmed", "inferred"] }
      }
    },
    "param_guidance": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sweet_spot": { "type": "string", "maxLength": 200 },
          "tradeoff": { "type": "string", "maxLength": 500 },
          "source": { "type": "string", "maxLength": 500 },
          "confidence": { "enum": ["confirmed", "inferred"] }
        }
      }
    },
    "known_failures": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["pattern", "mitigation", "source"],
        "properties": {
          "pattern": { "type": "string", "maxLength": 500 },
          "mitigation": { "type": "string", "maxLength": 500 },
          "flag": { "type": "string", "maxLength": 64 },
          "source": { "type": "string", "maxLength": 500 },
          "confidence": { "enum": ["confirmed", "inferred"] }
        }
      }
    },
    "vocab": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string", "maxLength": 80 }, "maxItems": 40 }
    },
    "example_prompts": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "prompt": { "type": "string", "maxLength": 2000 },
          "source": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "sources": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 40 },
    "capabilities": {
      "type": "object",
      "properties": {
        "reference_roles": { "type": "array", "items": { "type": "string" }, "maxItems": 16 },
        "needs_mask": { "type": "boolean" },
        "instruction_based": { "type": "boolean" },
        "supports_negative": { "type": "boolean" }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "max_prompt_tokens": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "params": { "type": "object" }
      }
    },
    "style_rules": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 64 },
    "templates": { "type": "object" },
    "preservation_clause": { "type": "string", "maxLength": 1000 },
    "negative_defaults": { "type": "string", "maxLength": 1000 },
    "exemplars": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "intent": { "type": "string", "maxLength": 1000 },
          "prompt": { "type": "string", "maxLength": 4000 }
        }
      }
    },
    "notes": { "type": "string", "maxLength": 4000 }
  },
  "definitions": {
    "claimList": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["rule", "source"],
        "properties": {
          "rule": { "type": "string", "maxLength": 500 },
          "source": { "type": "string", "maxLength": 500 },
          "confidence": { "enum": ["confirmed", "inferred"] }
        }
      }
    }
  }
}
