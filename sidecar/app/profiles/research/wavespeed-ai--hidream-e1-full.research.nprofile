model: wavespeed-ai/hidream-e1-full
paradigm: instruction
layer: research
version: research-2026-07
prompt_grammar:
  voice: imperative
  person: 2nd-person command
  tense: present
  ideal_length_tokens: 40
  structure:
  - change_clause
  - preservation_clause
dos:
- rule: Describe the change (wardrobe, accessories, color tweaks, minor scene adjustments);
    the model 'keeps the subject and overall composition stable'.
  source: https://wavespeed.ai/docs/docs-api/wavespeed-ai/hidream-e1-full
  confidence: confirmed
donts:
- rule: Avoid large structural rewrites — the card scopes it to identity-preserving
    edits of a single input image.
  source: https://wavespeed.ai/docs/docs-api/wavespeed-ai/hidream-e1-full
  confidence: inferred
negative_prompt:
  supported: false
  field: null
  default: null
  source: https://wavespeed.ai/docs/docs-api/wavespeed-ai/hidream-e1-full
  confidence: inferred
param_guidance: {}
known_failures: []
vocab: {}
example_prompts: []
sources:
- https://wavespeed.ai/docs/docs-api/wavespeed-ai/hidream-e1-full
notes: 'HiDream-E1 Full: prompt-based identity-preserving edits (WaveSpeed card).'
